# Existing aggregator source
HIGHER_GOV_API_KEY=

# Optional: SAM.gov public Opportunities API key
# Create/view it in SAM.gov Account Details > Public API Key.
SAM_GOV_API_KEY=

# Optional rolling posted-date window for SAM.gov searches (default: 120 days)
SAM_GOV_LOOKBACK_DAYS=120

# Optional AI selection: claude, claude-code, codex, or gemini.
# With no setting: Claude API -> Claude CLI -> Codex CLI -> Gemini.
# Claude runtime failures automatically retry once with Codex when installed.
AI_PROVIDER=
ANTHROPIC_API_KEY=
CLAUDE_CODE_PATH=
CLAUDE_CODE_MODEL=
# Uses the existing Codex CLI login. Set a path only if auto-detection fails.
CODEX_PATH=
CODEX_MODEL=
GEMINI_API_KEY=

# Teams delivery. Keep the existing webhook as the Gov Contracting destination.
TEAMS_WEBHOOK_URL=
# Set TEAMS_SEND_TARGET=test while testing, then set it back to gov.
TEAMS_SEND_TARGET=gov
# Personal/test Teams webhook used only when TEAMS_SEND_TARGET=test.
TEAMS_TEST_WEBHOOK_URL=
TEAMS_AUTO=on

# Optional duplicate prevention. When on, the app searches this chat before sending.
# Use a delegated Microsoft Graph token with permission to read the target chat.
TEAMS_DUPLICATE_CHECK=off
TEAMS_DUPLICATE_CHECK_STRICT=on
TEAMS_GRAPH_ACCESS_TOKEN=
TEAMS_SEARCH_CHAT_NAME=Gov Contracting
# Optional; if omitted, the app resolves the chat by name through /me/chats.
TEAMS_SEARCH_CHAT_ID=
